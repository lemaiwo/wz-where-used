{
  "_version": "1.65.0",
  "sap.app": {
    "id": "be.lemtech.wz.whereused",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [
        ""
      ],
      "fallbackLocale": ""
    },
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "odata/v4/where-used/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "WorkZoneContent-whereUsed": {
          "semanticObject": "WorkZoneContent",
          "action": "whereUsed",
          "title": "{{appTitle}}",
          "subTitle": "{{appSubTitle}}",
          "icon": "sap-icon://chain-link",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://chain-link"
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.ui.unified": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "be.lemtech.wz.whereused.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ContentItemsList",
          "target": "ContentItemsList"
        },
        {
          "pattern": "ContentItems({key}):?query:",
          "name": "ContentItemsObjectPage",
          "target": "ContentItemsObjectPage"
        }
      ],
      "targets": {
        "ContentItemsList": {
          "type": "Component",
          "id": "ContentItemsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ContentItems",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "navigation": {
                "ContentItems": {
                  "detail": {
                    "route": "ContentItemsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "None"
                  },
                  "actions": {
                    "importExport": {
                      "press": "be.lemtech.wz.whereused.ext.ImportAction.open",
                      "text": "{i18n>importAction}",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": false
                    }
                  }
                }
              }
            }
          }
        },
        "ContentItemsObjectPage": {
          "type": "Component",
          "id": "ContentItemsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/ContentItems",
              "editableHeaderContent": false,
              "controlConfiguration": {
                "roles/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "None"
                  }
                },
                "pages/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "None"
                  }
                },
                "spaces/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "None"
                  }
                },
                "catalogs/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "None"
                  }
                },
                "groups/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "None"
                  }
                },
                "contains/@com.sap.vocabularies.UI.v1.LineItem#Contains": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "None"
                  }
                }
              },
              "navigation": {
                "roles": {
                  "detail": {
                    "route": "ContentItemsObjectPage"
                  }
                },
                "pages": {
                  "detail": {
                    "route": "ContentItemsObjectPage"
                  }
                },
                "spaces": {
                  "detail": {
                    "route": "ContentItemsObjectPage"
                  }
                },
                "catalogs": {
                  "detail": {
                    "route": "ContentItemsObjectPage"
                  }
                },
                "groups": {
                  "detail": {
                    "route": "ContentItemsObjectPage"
                  }
                },
                "contains": {
                  "detail": {
                    "route": "ContentItemsObjectPage"
                  }
                }
              }
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "be.lemtech.wz.whereused.ext.ObjectPageExt"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.cloud": {
    "public": true,
    "service": "wzwhereused.service"
  }
}
